{
  "default_model": "fixture",
  "models": [
    {
      "id": "fixture",
      "provider": "deepseek",
      "protocol": "deepseek",
      "model": "deepseek-flash",
      "base_url": "http://127.0.0.1:58840",
      "api_key_ref": "fixture-key",
      "context_window_tokens": 100
    }
  ],
  "schema_version": 1,
  "tui": {
    "status_line": {
      "cache_format": "ratio",
      "cache_scope": "session",
      "clock_refresh_ms": 1000,
      "context_bar": {
        "width": 10,
        "show_percent": true,
        "style": "unicode",
        "warning_percent": 80,
        "critical_percent": 95
      },
      "enabled": false,
      "environment_refresh_ms": 5000,
      "git_timeout_ms": 500,
      "items": [],
      "max_rows": 2,
      "separator": " │ ",
      "time_format": "compact",
      "token_format": "compact",
      "unknown": "show"
    },
    "status_messages": {
      "preparing": [
        "preparing"
      ],
      "responding": [
        "responding"
      ],
      "thinking": [
        "Thought"
      ],
      "waiting": [
        "waiting"
      ]
    }
  }
}
